* text=auto eol=lf

# Files whose SHA-256 is recorded (verify/README.md, docs/data/manifest.json, results/run_all.json)
# or whose bytes are checked by the Lean kernel: no end-of-line conversion, so the hashes stay stable.
results/*.json -text
docs/data/* -text
lean/KS/*.lean -text

# binary files
*.drat binary
*.wasm binary
*.png binary
*.pdf binary
*.exe binary
