theorem refu_ok : refuteRoot pool ksSet (refuOfList refuToks) = true := by decide +kernel

theorem ksSet_lt : ksSet < 2 ^ 49 := by decide +kernel

theorem ksSet_card : card 49 ksSet = 31 := by decide +kernel

/-- The 31-ray set has no Kochen-Specker colouring: it is a Kochen-Specker set. -/
theorem ksSet_not_colorable : ¬ Colorable pool ksSet :=
  not_colorable_of_refute_root pool ksSet _ refu_ok

/-- The minimum size of a Kochen-Specker set inside the pool is exactly 31. -/
theorem minimum_ks_size :
    (∃ T, T < 2 ^ 49 ∧ card 49 T = 31 ∧ ¬ Colorable pool T) ∧
    (∀ T, T < 2 ^ 49 → card 49 T ≤ 30 → Colorable pool T) :=
  ⟨⟨ksSet, ksSet_lt, ksSet_card, ksSet_not_colorable⟩, small_sets_colorable⟩

/-! ### The same result for the vectors themselves (KS/Spec.lean) -/

/-- The list `rays` is the pool B(3,2): the primitive integer vectors of length 3 with
entries in -2..2 whose first non-zero entry is positive, in lexicographic order. -/
theorem rays_eq : rays = boxRays 3 2 := by decide +kernel

/-- The pool B(3,2) has 49 rays. -/
theorem rays_length : (boxRays 3 2).length = 49 := by decide +kernel

/-- Every ray of Z^3 with a representative of max-norm at most 2 is listed exactly once:
each non-zero integer vector of length 3 with entries in -2..2 is parallel to exactly one
vector of `boxRays 3 2`. -/
theorem boxRays_exact :
    ∀ v : List Int, v.length = 3 → (∀ a, a ∈ v → -2 ≤ a ∧ a ≤ 2) → (∃ a, a ∈ v ∧ a ≠ 0) →
      (boxRays 3 2).countP (fun u => parallel u v) = 1 :=
  countP_parallel_of_boxExact (d := 3) (H := 2) (by decide +kernel)

/-- The minimum size of a Kochen-Specker set inside B(3,2) is exactly 31, stated with the
vectors only.  A set of rays is the bit mask `T` of their positions in `boxRays 3 2`;
`VColorable` speaks about dot products of the listed vectors and nothing else. -/
theorem minimum_ks_size_vectors :
    (∃ T, T < 2 ^ 49 ∧ card 49 T = 31 ∧ ¬ VColorable (boxRays 3 2) 3 T) ∧
    (∀ T, T < 2 ^ 49 → card 49 T ≤ 30 → VColorable (boxRays 3 2) 3 T) := by
  rw [← rays_eq]
  obtain ⟨⟨T, hT, hcard, hnot⟩, hall⟩ := minimum_ks_size
  exact ⟨⟨T, hT, hcard, fun h => hnot
      (colorable_of_vcolorable adj_spec bases_sound bases_complete T hT h)⟩,
    fun T hT hcard =>
      vcolorable_of_colorable adj_spec bases_sound bases_complete T hT (hall T hT hcard)⟩

end KS.Box3H2
