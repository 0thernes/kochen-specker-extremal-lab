theorem cert_ok : checkRoot pool 17 (certOfList certToks) = true := by decide +kernel

/-- Every set of at most 17 rays of the pool has a Kochen-Specker colouring. -/
theorem small_sets_colorable : ∀ T, T < 2 ^ 40 → card 40 T ≤ 17 → Colorable pool T :=
  small_sets_colorable_root pool 17 _ cert_ok

/-- A set of 18 rays of the pool (as a mask). -/
def ksSet : Nat := 0x2aac0aaaad

/-- Refutation tree (45 nodes) in postfix form. -/
def refuToks : List Nat := [
  3, 22, 0, 1, 27, 2, 15, 3, 26, 0, 1, 37, 2, 11, 0, 1,
