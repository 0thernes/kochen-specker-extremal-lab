theorem refu_ok : refuteRoot pool ksSet (refuOfList refuToks) = true := by decide +kernel

theorem ksSet_lt : ksSet < 2 ^ 40 := by decide +kernel

theorem ksSet_card : card 40 ksSet = 18 := by decide +kernel

/-- The 18-ray set has no Kochen-Specker colouring: it is a Kochen-Specker set. -/
theorem ksSet_not_colorable : ¬ Colorable pool ksSet :=
  not_colorable_of_refute_root pool ksSet _ refu_ok

/-- The minimum size of a Kochen-Specker set inside the pool is exactly 18. -/
theorem minimum_ks_size :
    (∃ T, T < 2 ^ 40 ∧ card 40 T = 18 ∧ ¬ Colorable pool T) ∧
    (∀ T, T < 2 ^ 40 → card 40 T ≤ 17 → Colorable pool T) :=
  ⟨⟨ksSet, ksSet_lt, ksSet_card, ksSet_not_colorable⟩, small_sets_colorable⟩

/-! ### The same result for the vectors themselves (KS/Spec.lean) -/

/-- The list `rays` is the pool B(4,1): the primitive integer vectors of length 4 with
entries in -1..1 whose first non-zero entry is positive, in lexicographic order. -/
theorem rays_eq : rays = boxRays 4 1 := by decide +kernel

/-- The pool B(4,1) has 40 rays. -/
theorem rays_length : (boxRays 4 1).length = 40 := by decide +kernel

/-- Every ray of Z^4 with a representative of max-norm at most 1 is listed exactly once:
each non-zero integer vector of length 4 with entries in -1..1 is parallel to exactly one
vector of `boxRays 4 1`. -/
theorem boxRays_exact :
    ∀ v : List Int, v.length = 4 → (∀ a, a ∈ v → -1 ≤ a ∧ a ≤ 1) → (∃ a, a ∈ v ∧ a ≠ 0) →
      (boxRays 4 1).countP (fun u => parallel u v) = 1 :=
  countP_parallel_of_boxExact (d := 4) (H := 1) (by decide +kernel)

/-- The minimum size of a Kochen-Specker set inside B(4,1) is exactly 18, stated with the
vectors only.  A set of rays is the bit mask `T` of their positions in `boxRays 4 1`;
`VColorable` speaks about dot products of the listed vectors and nothing else. -/
theorem minimum_ks_size_vectors :
    (∃ T, T < 2 ^ 40 ∧ card 40 T = 18 ∧ ¬ VColorable (boxRays 4 1) 4 T) ∧
    (∀ T, T < 2 ^ 40 → card 40 T ≤ 17 → VColorable (boxRays 4 1) 4 T) := by
  rw [← rays_eq]
  obtain ⟨⟨T, hT, hcard, hnot⟩, hall⟩ := minimum_ks_size
  exact ⟨⟨T, hT, hcard, fun h => hnot
      (colorable_of_vcolorable adj_spec bases_sound bases_complete T hT h)⟩,
    fun T hT hcard =>
      vcolorable_of_colorable adj_spec bases_sound bases_complete T hT (hall T hT hcard)⟩

end KS.Box4H1
